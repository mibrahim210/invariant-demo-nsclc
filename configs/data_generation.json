{
  "schema_version": "1.0.0",
  "dataset_id": "invariant-synthetic-nsclc-v1",
  "generator_version": "1.0.0",
  "definition_status": "specified_not_generated_or_measured",
  "synthetic_only": true,
  "source_data": "procedural_only_no_external_patient_or_public_dataset_inputs",
  "randomness": {
    "rng": "numpy.random.Generator(PCG64)",
    "data_seed": 20260925,
    "label_seed": 20260926,
    "patient_stream_rule": "SeedSequence([data_seed, patient_index]); patient_index in ascending order; independent label RNG"
  },
  "cohort": {
    "patient_count": 200,
    "studies_per_patient": 1,
    "slices_per_patient": 8,
    "sample_count": 1600,
    "label_classes": [
      0,
      1
    ],
    "patients_per_class": 100,
    "label_assignment": "shuffle 100 zeros and 100 ones with label_seed; assign in patient_index order"
  },
  "sample": {
    "format": "npy",
    "allow_pickle": false,
    "dtype": "float32",
    "shape": [
      2,
      64,
      64
    ],
    "channel_order": [
      "ct_like",
      "pet_like"
    ],
    "value_range": [
      0.0,
      1.0
    ],
    "memory_order": "C",
    "slice_positions": "linspace(-1, 1, 8)",
    "channel_alignment": "shared anatomy, lesion center and slice position"
  },
  "identity": {
    "patient_id_template": "NSCLC_P{patient_index:03d}",
    "study_id_template": "{patient_id}_ST00",
    "slice_id_template": "{patient_id}_S{slice_index:02d}",
    "patient_index_start": 0,
    "slice_index_start": 0,
    "array_path_template": "data/slices/{slice_id}.npy"
  },
  "generation": {
    "coordinate_system": "pixel centers; x,y in [0,63]",
    "anatomy": {
      "body_center_xy": [
        31.5,
        31.5
      ],
      "body_center_jitter_px": 2.0,
      "body_radii_xy_px": [
        26.0,
        29.0
      ],
      "lung_centers_xy": [
        [
          22.0,
          32.0
        ],
        [
          41.0,
          32.0
        ]
      ],
      "lung_radii_xy_px": [
        8.0,
        17.0
      ],
      "geometry_distribution": "independent of label"
    },
    "texture": {
      "method": "patient-specific 8x8 standard-normal grid; nearest repeat 8x8 to 64x64; clip to [-3,3] and divide by 3",
      "persistent_across_slices": true,
      "independent_of_label": true,
      "ct_amplitude": 0.2,
      "pet_amplitude": 0.15
    },
    "lesion": {
      "center_rule": "sample one lung with probability 0.5; add uniform x,y offsets in [-3,3] pixels; shared across channels",
      "profile": "Gaussian centered at lesion center",
      "radius_px_by_label": {
        "0": 3.0,
        "1": 4.0
      },
      "ct_amplitude_by_label": {
        "0": 0.12,
        "1": 0.16
      },
      "pet_amplitude_by_label": {
        "0": 0.25,
        "1": 0.35
      }
    },
    "slice_variation": {
      "shared_translation_max_px": 1.0,
      "lesion_scale_rule": "1 - 0.15 * abs(slice_position)",
      "noise_distribution": "independent zero-mean Gaussian per channel and slice",
      "ct_noise_std": 0.03,
      "pet_noise_std": 0.03
    },
    "intensity": {
      "ct_background": 0.02,
      "ct_body": 0.45,
      "ct_lung": 0.2,
      "pet_background": 0.01,
      "pet_body": 0.08,
      "mapping": "fixed constants, additive masked texture and lesion, then clip to [0,1]; no cohort-fitted normalization"
    },
    "implementation_rule": "Implement these rules in data_gen.py; exact mask, translation, boundary and RNG draw order must be documented and versioned before freezing image hashes."
  },
  "outputs": {
    "metadata": "data/metadata.csv",
    "metadata_columns": [
      "slice_id",
      "patient_id",
      "study_id",
      "slice_index",
      "array_path",
      "label",
      "generator_version"
    ],
    "metadata_sort": [
      "patient_id",
      "slice_index"
    ],
    "image_manifest": "data/image_manifest.json",
    "image_manifest_rule": "JSON array sorted by relative POSIX array_path; entries {array_path, sha256}; SHA-256 over actual .npy file bytes",
    "generation_manifest": "data/generation_manifest.json",
    "generation_manifest_fields": [
      "generator_version",
      "generator_git_sha",
      "configuration_sha256",
      "metadata_sha256",
      "image_manifest_sha256",
      "dependency_versions",
      "sample_count"
    ]
  },
  "experiment": {
    "primary_split_seed": 0,
    "split_seeds": [
      0,
      1,
      2,
      3,
      4
    ],
    "test_size": 0.2,
    "split_function": "demo_repo.splits:make_split",
    "buggy_split": {
      "class": "sklearn.model_selection.train_test_split",
      "unit": "slice_id",
      "shuffle": true,
      "stratify": "label"
    },
    "fixed_split": {
      "class": "sklearn.model_selection.GroupShuffleSplit",
      "n_splits": 1,
      "groups": "patient_id",
      "stratified": false
    },
    "model": {
      "class": "sklearn.neighbors.KNeighborsClassifier",
      "n_neighbors": 5,
      "weights": "distance",
      "algorithm": "brute",
      "metric": "euclidean",
      "n_jobs": 1,
      "input": "images_only",
      "feature_transform": "non-overlapping 8x8 block means per channel; (2,64,64) -> (2,8,8); C-order flatten to 128 features",
      "fitted_preprocessing": "none",
      "augmentation": "none",
      "prediction": "predict_proba for class 1",
      "model_seed": null
    },
    "evaluation": {
      "primary_metric": "patient_roc_auc",
      "patient_aggregation": "arithmetic mean of held-out slice probabilities per patient",
      "positive_label": 1,
      "secondary_metric": "slice_roc_auc",
      "undefined_auc": "null plus reason; never replace with zero",
      "seed_summary": "retain all seeds; report individual values, mean and population standard deviation of defined values with defined/total count; summarize per-seed differences only for seeds with both AUCs defined",
      "auc_target": null
    }
  },
  "freeze_policy": {
    "freeze_before_report_a": true,
    "same_dataset_for_report_a_and_b": true,
    "retain_all_seed_results": true,
    "allow_test_driven_seed_selection": false,
    "untouched_external_cohort": false
  }
}
